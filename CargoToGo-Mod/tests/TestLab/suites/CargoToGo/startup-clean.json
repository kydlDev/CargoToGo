{
  "name": "startup-clean",
  "description": "The mod's own InGameTests pass in a TestLab world, the cargo items exist and nothing logged an error",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "CargoToGo.arena",
      "contains": "arena at"
    },
    {
      "do": "wait",
      "seconds": 6
    },
    {
      "do": "hook",
      "name": "CargoToGo.selftest",
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "InGameTests"
    },
    {
      "do": "check",
      "check": "hook",
      "name": "CargoToGo.cargoItems",
      "min": 1,
      "label": "CargoToGo.cargoItems within its limits"
    },
    {
      "do": "console",
      "command": "killall"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "CargoToGo"
    }
  ]
}
