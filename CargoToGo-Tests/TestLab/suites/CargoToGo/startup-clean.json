{
  "name": "startup-clean",
  "description": "The mod's own InGameTests pass in a TestLab world, the cargo items exist and nothing logged an error",
  "timeout": 60,
  "steps": [
    { "do": "wait", "seconds": 6 },
    { "do": "hook", "name": "CargoToGo.selftest", "contains": "PASS", "notContains": "FAIL", "label": "InGameTests" },
    { "do": "hook", "name": "CargoToGo.cargoItems", "min": 1 }
  ],
  "asserts": [ { "check": "noErrors", "source": "CargoToGo" } ]
}